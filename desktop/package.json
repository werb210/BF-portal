{
  "name": "boreal-portal-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Electron desktop shell for the Boreal staff portal (macOS and Windows)",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --arm64",
    "dist:win": "electron-builder --win --publish always",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.boreal.portal.desktop",
    "productName": "Boreal Staff Portal",
    "directories": {
      "output": "release"
    },
    "files": [
      "icon.png",
      "main.cjs",
      "package.json",
      "preload.cjs"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "../public/icons/icon-512x512.png",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Boreal uses the microphone for staff phone calls placed through the in-app dialer."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Boreal Staff Portal"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "werb210",
        "repo": "BF-portal",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
